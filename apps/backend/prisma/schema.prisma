generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  phone         String     @unique
  name          String?
  username      String?    @unique
  profileImage  String?
  trustScore    Int        @default(0)
  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(CITIZEN)
  allowCivicComplaintContactSharing Boolean @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  location      UserLocation?
  posts         Post[]
  likes         Like[]
  witnesses     Witness[]
  postReports   PostReport[]   @relation("ReporterUser")
  userReports   UserReport[]   @relation("ReporterUser")
  reportedUsers UserReport[]   @relation("ReportedUser")
  complaints    Complaint[]
  civicStatusHistories CivicComplaintStatusHistory[] @relation("StatusHistoryActor")
  notifications Notification[]
  comments      Comment[]
  commentReports CommentReport[] @relation("CommentReporterUser")
  feedbacks      Feedback[]
  following      Follow[]       @relation("UserFollower")
  followers      Follow[]       @relation("UserFollowing")
  conversationParticipants ConversationParticipant[]
  sentMessages            Message[]
  advertisements          Advertisement[]

  @@index([status])
}

// Coordinates remain scalar fields for Prisma compatibility. Future spatial
// queries can use PostGIS SQL/raw queries without coupling this foundation to
// an unsupported Prisma geography/geometry type.
model UserLocation {
  id             String    @id @default(uuid())
  userId         String    @unique
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  capturedAt     DateTime
  localityId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locality       Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([localityId])
}

model Locality {
  id             String             @id @default(uuid())
  name           String
  type           GeographicAreaType @default(LOCALITY)
  parentId       String?

  // Retained as the compatibility projection used by GET /location/me/locality.
  // Hierarchy ownership is represented by parentId and the self relation.
  city           String
  state          String
  country        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  parent         Locality?  @relation("LocalityHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Locality[] @relation("LocalityHierarchy")
  userLocations  UserLocation[]
  posts          Post[]

  @@unique([name, type, parentId])
  @@index([type])
  @@index([parentId])
}

model Post {
  id                 String             @id @default(uuid())
  authorId           String
  localityId         String?
  content            String
  category           PostCategory       @default(GENERAL)
  verificationStatus VerificationStatus @default(REPORTED)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)
  likes      Like[]
  witnesses  Witness[]
  verificationEvents        VerificationEvent[]
  verificationContributions VerificationContribution[]
  reports    PostReport[]
  complaints Complaint[]
  civicComplaint CivicComplaint?
  comments   Comment[]

  @@index([authorId, createdAt])
  @@index([localityId, deletedAt, createdAt, id])
  @@index([deletedAt, verificationStatus, createdAt])
  @@index([category, deletedAt, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId, createdAt])
}

model Witness {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId, createdAt])
}

// Backend-owned verification lifecycle history. Public and safe: no user
// relation, no witness identity, no coordinates. Post deletion cascades.
model VerificationEvent {
  id         String                  @id @default(uuid())
  postId     String
  type       VerificationEventType
  fromStatus VerificationStatus?
  toStatus   VerificationStatus?
  createdAt  DateTime                @default(now())

  post       Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
}

// Backend-internal record of a user action that contributed to verification.
// Deliberately attribution-free for now; a future Trust System may consume
// these records without rewriting WitnessService or VerificationService.
model VerificationContribution {
  id        String                         @id @default(uuid())
  postId    String
  type      VerificationContributionType
  createdAt DateTime                       @default(now())

  post      Post                           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
}

enum GeographicAreaType {
  COUNTRY
  STATE
  CITY
  LOCALITY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  CITIZEN
  MODERATOR
}

enum PostCategory {
  GENERAL
  INFRASTRUCTURE
  SAFETY
  UTILITIES
  ENVIRONMENT
  OTHER
}

enum VerificationStatus {
  REPORTED
  UNDER_VERIFICATION
  LOCALLY_VERIFIED
}

enum VerificationEventType {
  POST_CREATED
  WITNESS_ADDED
  WITNESS_REMOVED
  STATUS_CHANGED
}

enum VerificationContributionType {
  WITNESS
  STATUS_TRANSITION
}

enum PostReportReason {
  SPAM
  HARASSMENT
  FALSE_INFORMATION
  INAPPROPRIATE_CONTENT
  DANGEROUS_CONTENT
  OTHER
}

enum UserReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  ABUSIVE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum FeedbackType {
  BUG
  FEEDBACK
  SUGGESTION
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Feedback {
  id          String         @id @default(uuid())
  userId      String
  type        FeedbackType
  message     String
  appVersion  String?
  platform    String?
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum ModerationAuditAction {
  REPORT_CREATED
  REPORT_REVIEWED
  REPORT_RESOLVED
  REPORT_DISMISSED
  POST_HIDDEN
  POST_RESTORED
  USER_SUSPENDED
  USER_UNSUSPENDED
  FEEDBACK_STATUS_UPDATED
}

enum ComplaintStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CITIZEN_CONFIRMED
  REOPENED
}

model PostReport {
  id          String          @id @default(uuid())
  postId      String
  reporterId  String
  reason      PostReportReason
  description String?
  status      ReportStatus    @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  post        Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User            @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status])
}

model UserReport {
  id              String           @id @default(uuid())
  reportedUserId  String
  reporterId      String
  reason          UserReportReason
  description     String?
  status          ReportStatus     @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reportedUser    User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter        User             @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status])
}

model ModerationAuditEvent {
  id          String               @id @default(uuid())
  reportId    String?
  feedbackId  String?
  action      ModerationAuditAction
  actorId     String?
  createdAt   DateTime             @default(now())

  @@index([reportId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
}

model Complaint {
  id          String           @id @default(uuid())
  postId      String
  createdById String
  status      ComplaintStatus  @default(SUBMITTED)
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  statusHistory ComplaintStatusHistory[]

  @@unique([postId, createdById])
  @@index([createdById, createdAt])
  @@index([status])
}

model ComplaintStatusHistory {
  id         String            @id @default(uuid())
  complaintId String
  fromStatus ComplaintStatus?
  toStatus   ComplaintStatus
  createdAt  DateTime          @default(now())

  complaint  Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt, id])
}

enum CivicComplaintStatus {
  DRAFT
  SENT
  FAILED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CITIZEN_CONFIRMED
  REOPENED
}

model CivicComplaint {
  id             String               @id @default(uuid())
  postId         String               @unique
  referenceCode  String               @unique
  authorityEmail String
  subject        String
  body           String
  witnessCount   Int
  status         CivicComplaintStatus @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  post           Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  statusHistory  CivicComplaintStatusHistory[]

  @@index([postId])
  @@index([status])
  @@index([referenceCode])
}

model CivicComplaintStatusHistory {
  id          String               @id @default(uuid())
  complaintId String
  fromStatus  CivicComplaintStatus?
  toStatus    CivicComplaintStatus
  actorId     String
  note        String?
  createdAt   DateTime             @default(now())

  complaint   CivicComplaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor       User                 @relation("StatusHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt, id])
  @@index([actorId])
}

enum NotificationType {
  CIVIC_COMPLAINT_SENT
  CIVIC_COMPLAINT_ACKNOWLEDGED
  CIVIC_COMPLAINT_IN_PROGRESS
  CIVIC_COMPLAINT_RESOLVED
  CIVIC_COMPLAINT_CONFIRMED
  CIVIC_COMPLAINT_REOPENED
  USER_FOLLOWED
  MESSAGE_RECEIVED
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  body          String
  referenceType String           @default("CIVIC_COMPLAINT")
  referenceId   String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([userId, referenceType, referenceId, type])
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum CommentReportReason {
  SPAM
  HARASSMENT
  ABUSE
  MISLEADING
  INAPPROPRIATE
  OTHER
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentParentChild", fields: [parentId], references: [id], onDelete: Restrict)
  children Comment[] @relation("CommentParentChild")
  reports  CommentReport[]

  @@index([postId, createdAt, id])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CommentReport {
  id          String              @id @default(uuid())
  commentId   String
  reporterId  String
  reason      CommentReportReason
  description String?
  status      ReportStatus        @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation("CommentReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([commentId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

model Conversation {
  id             String                    @id @default(uuid())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  participantKey String?                   @unique
  participants   ConversationParticipant[]
  messages       Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  senderId        String
  content         String
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  clientMessageId String?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt, id])
}

enum AdvertisementStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdvertisementPlacement {
  FEED
  POST_DETAIL
  PROFILE
}

model Advertisement {
  id              String                 @id @default(uuid())
  title           String
  description     String?
  advertiserName  String
  creativeUrl     String
  destinationUrl  String
  ctaLabel        String?
  placement       AdvertisementPlacement
  status          AdvertisementStatus    @default(DRAFT)
  startAt         DateTime?
  endAt           DateTime?
  impressionCount Int                    @default(0)
  clickCount      Int                    @default(0)
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  createdBy       User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status, placement, deletedAt, startAt, endAt])
  @@index([createdById, createdAt])
}
