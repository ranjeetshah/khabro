generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  phone         String     @unique
  name          String?
  username      String?    @unique
  profileImage  String?
  trustScore    Int        @default(0)
  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(CITIZEN)
  allowCivicComplaintContactSharing Boolean @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  location      UserLocation?
  posts         Post[]
  likes         Like[]
  witnesses     Witness[]
  postReports   PostReport[]   @relation("ReporterUser")
  userReports   UserReport[]   @relation("ReporterUser")
  reportedUsers UserReport[]   @relation("ReportedUser")
  complaints    Complaint[]
  civicStatusHistories CivicComplaintStatusHistory[] @relation("StatusHistoryActor")

  @@index([status])
}

// Coordinates remain scalar fields for Prisma compatibility. Future spatial
// queries can use PostGIS SQL/raw queries without coupling this foundation to
// an unsupported Prisma geography/geometry type.
model UserLocation {
  id             String    @id @default(uuid())
  userId         String    @unique
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  capturedAt     DateTime
  localityId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locality       Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([localityId])
}

model Locality {
  id             String             @id @default(uuid())
  name           String
  type           GeographicAreaType @default(LOCALITY)
  parentId       String?

  // Retained as the compatibility projection used by GET /location/me/locality.
  // Hierarchy ownership is represented by parentId and the self relation.
  city           String
  state          String
  country        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  parent         Locality?  @relation("LocalityHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Locality[] @relation("LocalityHierarchy")
  userLocations  UserLocation[]
  posts          Post[]

  @@unique([name, type, parentId])
  @@index([type])
  @@index([parentId])
}

model Post {
  id                 String             @id @default(uuid())
  authorId           String
  localityId         String?
  content            String
  verificationStatus VerificationStatus @default(REPORTED)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)
  likes      Like[]
  witnesses  Witness[]
  verificationEvents        VerificationEvent[]
  verificationContributions VerificationContribution[]
  reports    PostReport[]
  complaints Complaint[]
  civicComplaint CivicComplaint?

  @@index([authorId, createdAt])
  @@index([localityId, deletedAt, createdAt, id])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId, createdAt])
}

model Witness {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId, createdAt])
}

// Backend-owned verification lifecycle history. Public and safe: no user
// relation, no witness identity, no coordinates. Post deletion cascades.
model VerificationEvent {
  id         String                  @id @default(uuid())
  postId     String
  type       VerificationEventType
  fromStatus VerificationStatus?
  toStatus   VerificationStatus?
  createdAt  DateTime                @default(now())

  post       Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
}

// Backend-internal record of a user action that contributed to verification.
// Deliberately attribution-free for now; a future Trust System may consume
// these records without rewriting WitnessService or VerificationService.
model VerificationContribution {
  id        String                         @id @default(uuid())
  postId    String
  type      VerificationContributionType
  createdAt DateTime                       @default(now())

  post      Post                           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
}

enum GeographicAreaType {
  COUNTRY
  STATE
  CITY
  LOCALITY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  CITIZEN
  MODERATOR
}

enum VerificationStatus {
  REPORTED
  UNDER_VERIFICATION
  LOCALLY_VERIFIED
}

enum VerificationEventType {
  POST_CREATED
  WITNESS_ADDED
  WITNESS_REMOVED
  STATUS_CHANGED
}

enum VerificationContributionType {
  WITNESS
  STATUS_TRANSITION
}

enum PostReportReason {
  SPAM
  HARASSMENT
  FALSE_INFORMATION
  INAPPROPRIATE_CONTENT
  DANGEROUS_CONTENT
  OTHER
}

enum UserReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  ABUSIVE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ModerationAuditAction {
  REPORT_CREATED
  REPORT_REVIEWED
  REPORT_RESOLVED
  REPORT_DISMISSED
  POST_HIDDEN
  POST_RESTORED
  USER_SUSPENDED
  USER_UNSUSPENDED
}

enum ComplaintStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CITIZEN_CONFIRMED
  REOPENED
}

model PostReport {
  id          String          @id @default(uuid())
  postId      String
  reporterId  String
  reason      PostReportReason
  description String?
  status      ReportStatus    @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  post        Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User            @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status])
}

model UserReport {
  id              String           @id @default(uuid())
  reportedUserId  String
  reporterId      String
  reason          UserReportReason
  description     String?
  status          ReportStatus     @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reportedUser    User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter        User             @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status])
}

model ModerationAuditEvent {
  id        String               @id @default(uuid())
  reportId  String?
  action    ModerationAuditAction
  createdAt DateTime             @default(now())

  @@index([reportId, createdAt])
  @@index([action, createdAt])
}

model Complaint {
  id          String           @id @default(uuid())
  postId      String
  createdById String
  status      ComplaintStatus  @default(SUBMITTED)
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  statusHistory ComplaintStatusHistory[]

  @@unique([postId, createdById])
  @@index([createdById, createdAt])
  @@index([status])
}

model ComplaintStatusHistory {
  id         String            @id @default(uuid())
  complaintId String
  fromStatus ComplaintStatus?
  toStatus   ComplaintStatus
  createdAt  DateTime          @default(now())

  complaint  Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt, id])
}

enum CivicComplaintStatus {
  DRAFT
  SENT
  FAILED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CITIZEN_CONFIRMED
  REOPENED
}

model CivicComplaint {
  id             String               @id @default(uuid())
  postId         String               @unique
  referenceCode  String               @unique
  authorityEmail String
  subject        String
  body           String
  witnessCount   Int
  status         CivicComplaintStatus @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  post           Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  statusHistory  CivicComplaintStatusHistory[]

  @@index([postId])
  @@index([status])
  @@index([referenceCode])
}

model CivicComplaintStatusHistory {
  id          String               @id @default(uuid())
  complaintId String
  fromStatus  CivicComplaintStatus?
  toStatus    CivicComplaintStatus
  actorId     String
  note        String?
  createdAt   DateTime             @default(now())

  complaint   CivicComplaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor       User                 @relation("StatusHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt, id])
  @@index([actorId])
}